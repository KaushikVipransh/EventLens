# ── Copy to .env for local development ──────────────────────────────────────

# Postgres (Docker: pgvector/pgvector). Production: swap to Supabase/Neon URL.
POSTGRES_USER=eventlens
POSTGRES_PASSWORD=eventlens
POSTGRES_DB=eventlens
POSTGRES_PORT=5433
DATABASE_URL=postgresql://eventlens:eventlens@localhost:5433/eventlens

# Redis (Docker). Production: swap to Upstash rediss:// URL.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Object storage — MinIO locally (S3-compatible). Production: Cloudflare R2.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=eventlens-photos
S3_FORCE_PATH_STYLE=true
# Public base URL used to build browser-facing object URLs (MinIO in dev).
S3_PUBLIC_URL=http://localhost:9000

# API
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3001

# Auth secrets — change in production.
JWT_SECRET=dev-super-secret-change-me
ATTENDEE_TOKEN_TTL=86400
PHOTOGRAPHER_TOKEN_TTL=604800

# Face recognition microservice (FastAPI + InsightFace).
FACE_PORT=8000
FACE_SERVICE_URL=http://localhost:8000
# Cosine distance threshold for a face "match" (lower = stricter). Tune in QA.
FACE_MATCH_THRESHOLD=0.42

# Storage-saver (worker): after face processing, the stored photo is re-encoded
# to a capped JPEG (discarding the camera-original) to save storage at scale.
# Set INGEST_MAX_EDGE=0 to disable and keep originals untouched.
INGEST_MAX_EDGE=2560
INGEST_QUALITY=82

# Google Drive import ("paste your Drive link").
# Legacy API-key path (public folders, small sizes — Google throttles bulk):
GOOGLE_API_KEY=
# OAuth path (preferred — reliable for large/private folders). Create an OAuth
# client ID (Web application) in Google Cloud Console; add the redirect URI
# below to it. Configure the consent screen with the drive.readonly scope.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/drive/oauth/callback

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
